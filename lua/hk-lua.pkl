import "../hk.pkl" as hk
import "../version.pkl" as version

steps = new Mapping<String, hk.Step> {
  ["[format] lua"] = (version.Builtins.stylua) {
    check = "stylua --config-path .config/generated/stylua.toml --check {{ files }}"
    fix = "stylua --config-path .config/generated/stylua.toml {{ files }}"
  }
  ["[lint] lua"] {
    glob = "**/*.lua"
    check = "lua-language-server --check --checklevel=Information ."
  }
}
