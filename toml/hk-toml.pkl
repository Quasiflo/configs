import "../hk.pkl" as hk
import "../version.pkl" as version

steps = new Mapping<String, hk.Step> {
  ["[format] toml"] = (version.Builtins.tombi_format) {
    check = "tombi format --check --diff --quiet {{ files }}"
    fix = "tombi format --quiet {{ files }}"
    exclude = version.Builtins.mise.glob
  }
  ["[lint] toml"] = (version.Builtins.tombi) {
    exclude = version.Builtins.mise.glob
  }
}
