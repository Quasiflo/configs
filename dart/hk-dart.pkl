import "../hk.pkl" as hk
import "../version.pkl" as version

steps = new Mapping<String, hk.Step> {
  ["[fix] pub"] {
    glob = List("**/pubspec.yaml", "**/pubspec.yml")
    check = "dart pub get --dry-run"
    fix = "dart pub get"
  }
  ["[fix] dart"] {
    glob = List("**/*.dart", "**/analysis_options.yaml", "**/pubspec.yaml", "**/pubspec.yml")
    check = "dart fix --dry-run"
    fix = "dart fix --apply"
    depends = List("[fix] pub")
  }
  ["[format] dart"] {
    glob = List("**/*.dart")
    check = "dart format --output=none --set-exit-if-changed {{ files }}"
    fix = "dart format {{ files }}"
    batch = true
  }
  ["[lint] dart"] {
    glob = List("**/*.dart", "**/analysis_options.yaml", "**/pubspec.yaml", "**/pubspec.yml")
    check = "dart analyze --fatal-infos"
  }
}
