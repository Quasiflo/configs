// * HK - Git Hook Configuration
// This file ensures you are committing properly linted and formatted files which will pass ci
amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"

import "generated/generated.pkl"

steps =
  generated.addSteps((generated.steps) {
    ["[fix] markdown"] {
      exclude = generated.steps["[fix] markdown"].exclude + List("licenses/*.md")
    }
    ["[lint] templatry"] {
      glob = List("**/*")
      check = "templatry validate"
    }
    ["[lint] urls"] {
      exclude = generated.steps["[lint] urls"].exclude + List("licenses/*.md")
    }
    ["[lint] file extensions"] {
      exclude = generated.steps["[lint] file extensions"].exclude + List("licenses/*")
    }
    ["[lint] copy-paste"] {
      exclude = List("licenses/*.md", "SECURITY.md")
    }
  })
