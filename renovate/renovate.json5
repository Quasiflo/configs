{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customDatasources": {
    "flutter": {
      "defaultRegistryUrlTemplate": "https://storage.googleapis.com/flutter_infra_release/releases/releases_linux.json",
      "transformTemplates": [
        "{ \"releases\": $map(releases[channel = \"stable\"], function($r) { { \"version\": $replace($r.version, \"-stable\", \"\") } }) }"
      ]
    },
    "dart": {
      "defaultRegistryUrlTemplate": "https://storage.googleapis.com/storage/v1/b/dart-archive/o?prefix=channels/stable/release/&delimiter=/",
      "transformTemplates": [
        "{ \"releases\": $map($filter(prefixes, function($p) { $contains($substringBefore($substringAfter($p, \"channels/stable/release/\"), \"/\"), \".\") }), function($p) { { \"version\": $substringBefore($substringAfter($p, \"channels/stable/release/\"), \"/\") } }), \"sourceUrl\": \"https://github.com/dart-lang/sdk\", \"homepage\": \"https://dart.dev\", \"changelogUrl\": \"https://github.com/dart-lang/sdk/blob/main/CHANGELOG.md\" }"
      ]
    }
  },
  "customManagers": [
    { // Update tools defined in mise using a http backend (requires matching custom datasource from above)
      "customType": "jsonata",
      "fileFormat": "toml",
      "managerFilePatterns": [
        "**/mise.toml",
        "**/mise.*.toml"
      ],
      "matchStrings": [
        "$each(tools ?? {}, function($tool, $name) { $substringBefore($name, \":\") = \"http\" ? { \"depName\": $substringAfter($name, \"http:\"), \"currentValue\": $tool.version, \"datasource\": \"custom.\" & $substringAfter($name, \"http:\") } : undefined })"
      ]
    },
    { // Update tools defined in mise using tool_alias
      "customType": "jsonata",
      "fileFormat": "toml",
      "managerFilePatterns": [
        "**/mise.toml",
        "**/mise.*.toml"
      ],
      "matchStrings": [
        "$each(tool_alias ?? {}, function($aliasTarget, $name) { { \"depName\": $name, \"packageName\": $substringAfter($aliasTarget, \"github:\"), \"currentValue\": $lookup(tools, $name).version, \"extractVersion\": \"^\" & $lookup(tools, $name).version_prefix & \"(?<version>.+)$\", \"datasource\": \"github-releases\" } })"
      ]
    },
    { // Update Templatry template versions from source releases
      customType: 'jsonata',
      description: 'Update templatry github source refs',
      fileFormat: 'toml',
      managerFilePatterns: [
        '(^|/)templatry\\.toml$'
      ],
      matchStrings: [
        // Singular `[source]` table.
        'source[$type(github) = "string" and $type(ref) = "string"].{"depName": github, "packageName": github, "currentValue": ref}',
        // Plural `[source.<name>]` tables.
        '$each(source, function($v, $k) {{"name": $k, "cfg": $v}})[$type(cfg) = "object" and $type(cfg.github) = "string" and $type(cfg.ref) = "string"].{"depName": name, "packageName": cfg.github, "currentValue": cfg.ref}',
      ],
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    { // Update dependencies in .pkl files, currently only for HK
      "autoReplaceStringTemplate": "package://github.com/{{{packageName}}}/releases/download/v{{{newValue}}}/{{{depName}}}@{{{newValue}}}#",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "description": "Update imported github pkl packages in .pkl files",
      "managerFilePatterns": [
        "**/*.pkl"
      ],
      "matchStrings": [
        "package:\\/\\/github.com\\/(?<packageName>[^/]+\\/[^/]+)\\/releases\\/download\\/v(?<currentValue>[^/]+)\\/(?<depName>[^\\s]+)@(?<currentValueCopy>[^/]+)#"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "abandonmentThreshold": "2 years",
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "mergeConfidence:all-badges",
    ":disableRateLimiting",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "ignorePresets": [
    "abandonments:recommended"
  ], // Avoid inheriting recommended 1 year abandonment threshold
  "hostRules": [
    {
      "matchHost": "circleci.com",
      "authType": "Token-Only",
      "token": "{{ secrets.CIRCLECI_TOKEN }}"
    }
  ],
  "internalChecksFilter": "strict",
  "labels": [
    "Chore 🧹"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [] // Run whenever renovate executes
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    { // Group deps by manager
      "groupName": "{{manager}} Dependencies",
      "matchManagers": [
        "*"
      ]
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump",
        "replacement"
      ],
      "minimumReleaseAge": "4 days"
    },
    {
      "matchSourceUrls": [
        "https://github.com/Quasiflo/**"
      ],
      "minimumReleaseAge": 0
    },
    { // Ensure all flutter_rust_bridge deps maintain identical version
      "groupName": "FRB Dependencies",
      "matchDepNames": [
        "flutter_rust_bridge",
        "flutter_rust_bridge_hooks",
        "flutter_rust_bridge_codegen",
        "cargo:flutter_rust_bridge_codegen"
      ]
    },
    {
      "groupName": "Mise Dependencies",
      "matchManagers": [
        "mise"
      ],
      "versioning": "semver-partial"
    },
    {
      "description": "Automerge minor/patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    { // Additional branch prefix allows targeted CI updates for templated config generation & re-linting
      "matchFileNames": [
        "**/templatry.toml"
      ],
      "additionalBranchPrefix": "ci/templatry/"
    },
    { // Ensure HK gets bumped in .pkl files at the same time as in mise
      "groupName": "hk",
      "matchPackageNames": [
        "jdx/hk"
      ]
    },
    {
      "extractVersion": "^lychee-v?(?<version>.+)$",
      "matchPackageNames": [
        "lycheeverse/lychee"
      ]
    }
  ],
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch"
}
