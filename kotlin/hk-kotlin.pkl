import "../hk.pkl" as hk
import "../version.pkl" as version

steps = new Mapping<String, hk.Step> {
  ["[fix] kotlin"] {
    glob = List("**/*.kt", "**/*.kts")
    check = "detekt-cli --config .config/generated/detekt.yml --input $(cat)"
    fix = "detekt-cli --config .config/generated/detekt.yml --input $(cat) --auto-correct"
    stdin = " {{ files_list | join(sep=',') }} "
  }
}
