import "../hk.pkl" as hk
import "../version.pkl" as version

steps = new Mapping<String, hk.Step> {
  ["[format] shell"] = version.Builtins.shfmt
  ["[lint] shell"] = version.Builtins.shellcheck
  ["[lint] shell strict mode"] {
    types = List("shell")
    check = ".config/generated/check-strict-lint.sh {{ files }}"
  }
}
